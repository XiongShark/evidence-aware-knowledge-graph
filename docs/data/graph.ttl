@prefix kg: <https://example.org/curriculum-workforce/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

kg:a1 a kg:Assessment ;
    rdfs:label "评估营销效果" ;
    kg:course kg:c1 ;
    kg:evidence <https://example.org/curriculum-workforce/evidence/a1> ;
    kg:limitation "真实投放中的预算决策、执行优化和监测结果，还需要项目或实务证据。" ;
    kg:relatedLevel <https://example.org/curriculum-workforce/level/3> ;
    kg:requirement kg:r1 ;
    kg:status "supported" ;
    kg:supportedScope "课程要求完成一次有明确范围的营销效果评估，包含计算指标和解读结果。" .

kg:a2 a kg:Assessment ;
    rdfs:label "优化营销活动" ;
    kg:course kg:c1 ;
    kg:evidence <https://example.org/curriculum-workforce/evidence/a2> ;
    kg:limitation "仍需证明能选定优化方案、执行干预并跟踪效果。" ;
    kg:relatedLevel <https://example.org/curriculum-workforce/level/2> ;
    kg:requirement kg:r1 ;
    kg:status "partial" ;
    kg:supportedScope "能为发现活动问题提供指标解读基础。" .

kg:a3 a kg:Assessment ;
    rdfs:label "分析渠道策略" ;
    kg:course kg:c2 ;
    kg:evidence <https://example.org/curriculum-workforce/evidence/a3> ;
    kg:limitation "仍需结合真实账号、品牌约束和业务目标制定策略。" ;
    kg:requirement kg:r2 ;
    kg:status "partial" ;
    kg:supportedScope "课程材料支持分析受众和渠道的适配性。" .

kg:a4 a kg:Assessment ;
    rdfs:label "负责日常运营" ;
    kg:course kg:c2 ;
    kg:evidence <https://example.org/curriculum-workforce/evidence/a4> ;
    kg:limitation "实际发布、用户互动和持续运营经验需要另外核验。" ;
    kg:requirement kg:r2 ;
    kg:status "partial" ;
    kg:supportedScope "课程内容可以帮助理解发布计划中的常见决策。" .

kg:a5 a kg:Assessment ;
    rdfs:label "更新生产网站" ;
    kg:course kg:c3 ;
    kg:evidence <https://example.org/curriculum-workforce/evidence/a5> ;
    kg:limitation "课程材料尚无生产网站编辑、审批流转或上线操作的直接证据。" ;
    kg:requirement kg:r3 ;
    kg:status "related" ;
    kg:supportedScope "提供阅读和理解网页的背景知识。" .

<https://example.org/curriculum-workforce/level/1> a kg:LevelObservation ;
    kg:action "识别常用指标" ;
    kg:level 1 ;
    kg:reason "材料说明课程会接触这一主题，缺少明确的操作任务。" ;
    kg:source "目录描述" ;
    kg:stage "了解概念" ;
    kg:text "课程介绍常见营销活动指标。" ;
    kg:type "主题" .

kg:c3 a kg:Course ;
    rdfs:label "网页设计基础" ;
    rdfs:comment "了解网页结构和页面呈现。" .

<https://example.org/curriculum-workforce/evidence/a1> a kg:Evidence ;
    kg:sourceType "考核任务" ;
    kg:text "独立用样本数据计算转化率，比较两组营销活动并说明结果。" .

<https://example.org/curriculum-workforce/evidence/a2> a kg:Evidence ;
    kg:sourceType "引导练习" ;
    kg:text "参照给出的解读步骤，说明两组样本指标的差异。" .

<https://example.org/curriculum-workforce/evidence/a3> a kg:Evidence ;
    kg:sourceType "学习成果" ;
    kg:text "针对模拟目标受众，比较两个社交渠道的选择依据。" .

<https://example.org/curriculum-workforce/evidence/a4> a kg:Evidence ;
    kg:sourceType "学习成果" ;
    kg:text "说明调整发布内容和时间的适用情境。" .

<https://example.org/curriculum-workforce/evidence/a5> a kg:Evidence ;
    kg:sourceType "课程主题" ;
    kg:text "课程介绍网页结构和页面呈现。" .

<https://example.org/curriculum-workforce/level/2> a kg:LevelObservation ;
    kg:action "按给定步骤解释指标差异" ;
    kg:level 2 ;
    kg:reason "材料要求解释指标，并且给出操作步骤；证据覆盖有指导的任务。" ;
    kg:source "学习成果与引导练习" ;
    kg:stage "辅助实践" ;
    kg:text "参照给出的解读步骤，说明两组样本指标的差异。" ;
    kg:type "能力" .

<https://example.org/curriculum-workforce/level/3> a kg:LevelObservation ;
    kg:action "独立完成一份效果评估" ;
    kg:level 3 ;
    kg:reason "任务要求独立计算、比较并说明结果，课程证据覆盖一次限定范围的模拟交付。" ;
    kg:source "考核任务" ;
    kg:stage "独立交付（模拟）" ;
    kg:text "独立用样本数据计算转化率，比较两组营销活动并说明结果。" ;
    kg:type "能力" .

kg:r3 a kg:Requirement ;
    rdfs:label "网站内容维护" ;
    rdfs:comment "按编辑审批流程更新生产网站内容。" .

kg:c1 a kg:Course ;
    rdfs:label "营销数据分析" ;
    rdfs:comment "用指标读懂营销活动的表现。" .

kg:c2 a kg:Course ;
    rdfs:label "社交媒体策略" ;
    rdfs:comment "理解不同受众与渠道的传播策略。" .

kg:r1 a kg:Requirement ;
    rdfs:label "营销效果评估与优化" ;
    rdfs:comment "评估营销活动成效，依据结果制定并执行优化措施。" .

kg:r2 a kg:Requirement ;
    rdfs:label "社交渠道运营" ;
    rdfs:comment "制定社交渠道策略，负责实际发布、互动和持续运营。" .
